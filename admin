<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản Trị Vòng Quay</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #05070e;
            color: #f1f5f9;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
            padding: 30px 20px;
            position: relative;
            overflow-x: hidden;
            margin: 0;
        }

        body::before {
            content: "";
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background-image: url('84c7b7a2-f470-48bc-89c7-66ea36606e32.png');
            background-size: cover; background-position: center; background-attachment: fixed;
            opacity: 0.35; z-index: -2;
        }

        body::after {
            content: "";
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: radial-gradient(circle at 50% 20%, rgba(56, 189, 248, 0.12) 0%, rgba(5, 7, 14, 0.9) 75%);
            z-index: -1;
        }

        .auth-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(5, 7, 14, 0.92);
            backdrop-filter: blur(25px);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }

        .auth-card {
            background: linear-gradient(135deg, rgba(30, 41, 59, 0.7) 0%, rgba(15, 23, 42, 0.85) 100%);
            border: 1px solid rgba(56, 189, 248, 0.3);
            border-radius: 32px;
            padding: 40px 30px;
            width: 100%;
            max-width: 400px;
            text-align: center;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.7), 0 0 30px rgba(56, 189, 248, 0.15);
            animation: fadeIn 0.4s ease-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(15px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .auth-card h2 { font-size: 24px; color: #fff; margin-bottom: 8px; font-weight: 800; }
        .auth-card p { font-size: 13px; color: #94a3b8; margin-bottom: 25px; }
        .auth-card input {
            width: 100%; padding: 14px 18px;
            background: rgba(15, 23, 42, 0.8);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 14px; color: #fff; font-size: 15px;
            text-align: center; margin-bottom: 18px; outline: none;
            transition: all 0.3s;
            box-sizing: border-box;
        }
        .auth-card input:focus {
            border-color: #38bdf8;
            box-shadow: 0 0 15px rgba(56, 189, 248, 0.3);
        }
        .auth-card button {
            width: 100%; padding: 14px;
            background: linear-gradient(135deg, #38bdf8 0%, #0284c7 100%);
            color: white; border: none; border-radius: 14px;
            font-weight: 700; font-size: 15px; cursor: pointer;
            box-shadow: 0 10px 20px rgba(2, 132, 199, 0.4);
            transition: all 0.3s;
        }
        .auth-card button:hover { transform: translateY(-2px); box-shadow: 0 15px 25px rgba(2, 132, 199, 0.6); }
        .error-msg { color: #f43f5e; font-size: 13px; margin-top: 12px; display: none; font-weight: 600; }

        .nav-bar {
            display: flex; gap: 10px; margin-bottom: 30px; flex-wrap: wrap; justify-content: center;
            background: rgba(15, 23, 42, 0.6); padding: 6px; border-radius: 50px;
            backdrop-filter: blur(20px); border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }
        .nav-btn {
            padding: 10px 26px; border-radius: 30px; border: none; background: transparent;
            color: #94a3b8; font-weight: 700; font-size: 13px; cursor: pointer; text-decoration: none;
            transition: all 0.3s ease; display: inline-flex; align-items: center; justify-content: center;
        }
        .nav-btn:hover { color: #fff; }
        .nav-btn.active {
            background: linear-gradient(135deg, #38bdf8 0%, #0284c7 100%); color: #ffffff;
            box-shadow: 0 4px 15px rgba(56, 189, 248, 0.4);
        }

        .page-title {
            font-size: 2.2rem; font-weight: 900; text-transform: uppercase;
            text-align: center; margin-bottom: 25px; color: #ffffff;
            letter-spacing: 1px; text-shadow: 0 0 25px rgba(56, 189, 248, 0.4);
        }

        .admin-dashboard {
            width: 100%; max-width: 1150px;
            background: linear-gradient(135deg, rgba(30, 41, 59, 0.45) 0%, rgba(15, 23, 42, 0.65) 100%);
            backdrop-filter: blur(40px) saturate(180%);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 32px; padding: 40px; box-shadow: 0 30px 80px rgba(0,0,0,0.7);
            box-sizing: border-box;
        }

        .stats-grid {
            display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-bottom: 35px;
        }
        .stat-card {
            background: rgba(255, 255, 255, 0.03); 
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 22px; padding: 22px 24px; 
            display: flex; flex-direction: column; gap: 8px;
            position: relative; overflow: hidden;
            transition: all 0.3s ease;
        }
        .stat-card:hover {
            border-color: rgba(56, 189, 248, 0.3);
            transform: translateY(-3px);
            background: rgba(255, 255, 255, 0.05);
        }
        .stat-card::after {
            content: ""; position: absolute; top: 0; right: 0; width: 60px; height: 60px;
            background: radial-gradient(circle, rgba(56,189,248,0.15) 0%, transparent 70%);
            pointer-events: none;
        }
        .stat-card span:first-child { font-size: 12px; color: #94a3b8; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }
        .stat-card span:last-child { font-size: 32px; color: #38bdf8; font-weight: 900; }

        .admin-section-title {
            font-size: 16px; font-weight: 800; color: #f8fafc; margin-bottom: 12px;
            display: flex; justify-content: space-between; align-items: center;
            letter-spacing: 0.5px;
        }

        .title-box-wrapper {
            display: flex; gap: 12px; margin-bottom: 35px;
        }
        .title-box-wrapper input {
            flex: 1; padding: 14px 18px; background: rgba(15, 23, 42, 0.8);
            border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 14px; 
            color: #fff; font-size: 14px; outline: none; font-family: inherit;
            transition: all 0.3s;
        }
        .title-box-wrapper input:focus {
            border-color: #38bdf8;
            box-shadow: 0 0 15px rgba(56, 189, 248, 0.2);
        }

        .password-container {
            max-width: 550px;
            margin: 20px auto;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }
        .password-container input {
            width: 100%; padding: 15px 20px; background: rgba(15, 23, 42, 0.8);
            border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 14px; 
            color: #fff; font-size: 14px; outline: none; font-family: inherit;
            transition: all 0.3s;
            box-sizing: border-box;
        }
        .password-container input:focus {
            border-color: #38bdf8;
            box-shadow: 0 0 15px rgba(56, 189, 248, 0.2);
        }

        .admin-table-wrapper {
            background: rgba(10, 15, 30, 0.6); 
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 20px; overflow: hidden; 
            max-height: 420px; overflow-y: auto; margin-bottom: 30px;
        }
        
        .admin-table-wrapper::-webkit-scrollbar { width: 6px; }
        .admin-table-wrapper::-webkit-scrollbar-track { background: rgba(15, 23, 42, 0.5); }
        .admin-table-wrapper::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.15); border-radius: 10px; }
        .admin-table-wrapper::-webkit-scrollbar-thumb:hover { background: rgba(56, 189, 248, 0.5); }

        .admin-table { width: 100%; border-collapse: collapse; }
        .admin-table th, .admin-table td { 
            padding: 15px 22px; 
            border-bottom: 1px solid rgba(255, 255, 255, 0.05); 
            font-size: 14px; text-align: left; 
        }
        .admin-table th { 
            background: rgba(15, 23, 42, 0.9); 
            color: #38bdf8; font-weight: 800; 
            position: sticky; top: 0; z-index: 10;
            backdrop-filter: blur(10px);
        }
        .admin-table tr { transition: background 0.2s; }
        .admin-table tr:hover { background: rgba(255, 255, 255, 0.02); }
        
        .admin-table input[type="number"] {
            width: 120px; padding: 9px 30px 9px 12px; background: rgba(15, 23, 42, 0.9);
            border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 10px; 
            color: #fff; text-align: center; font-weight: 700; font-family: inherit;
            outline: none; transition: all 0.2s;
            box-sizing: border-box;
        }
        .admin-table input[type="number"]:focus {
            border-color: #38bdf8;
            box-shadow: 0 0 10px rgba(56, 189, 248, 0.3);
        }

        .admin-actions-footer { display: flex; gap: 15px; justify-content: flex-end; align-items: center; }
        
        .tool-btn {
            padding: 13px 24px; background: rgba(239, 68, 68, 0.1); 
            border: 1px solid rgba(239, 68, 68, 0.3);
            border-radius: 14px; color: #fca5a5; font-size: 14px; font-weight: 700; 
            cursor: pointer; transition: all 0.3s;
        }
        .tool-btn:hover {
            background: rgba(239, 68, 68, 0.2);
            border-color: rgba(239, 68, 68, 0.5);
            transform: translateY(-2px);
        }

        .save-btn {
            background: linear-gradient(135deg, #38bdf8 0%, #0284c7 100%); 
            color: white; border: none;
            padding: 13px 32px; border-radius: 14px; font-size: 14px; font-weight: 800; 
            cursor: pointer; box-shadow: 0 10px 25px rgba(2, 132, 199, 0.4);
            transition: all 0.3s;
        }
        .save-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 30px rgba(2, 132, 199, 0.6);
        }

        @media (max-width: 768px) {
            .admin-dashboard { padding: 20px; }
            .page-title { font-size: 1.6rem; }
            .title-box-wrapper { flex-direction: column; }
            .admin-actions-footer { flex-direction: column; width: 100%; }
            .admin-actions-footer button { width: 100%; text-align: center; }
        }
    </style>
</head>
<body>
    <div class="auth-overlay" id="authModal">
        <div class="auth-card">
            <h2>🔒 Quản Trị Viên</h2>
            <p>Vui lòng nhập mật khẩu hệ thống để tiếp tục</p>
            <input type="password" id="adminPasswordInput" placeholder="Mật khẩu bảo mật...">
            <button id="loginBtn">Truy Cập Hệ Thống</button>
            <div class="error-msg" id="errorMsg">Mật khẩu không chính xác!</div>
        </div>
    </div>

    <div id="adminMainContent" style="display: none; width: 100%; flex-direction: column; align-items: center;">
        <div class="nav-bar">
            <a href="index.html" class="nav-btn">🎡 Trang Vòng Quay</a>
            <button class="nav-btn active" id="tabDashboardBtn">⚙️ Bảng Điều Khiển</button>
            <button class="nav-btn" id="tabPasswordBtn">🔑 Đổi Mật Khẩu</button>
            <button class="nav-btn" id="logoutBtn" style="background: rgba(239, 68, 68, 0.2); color: #fca5a5; border: 1px solid rgba(239, 68, 68, 0.4);">🚪 Đăng Xuất</button>
        </div>

        <h1 class="page-title" id="pageTitleText">Hệ Thống Quản Trị Vòng Quay</h1>
        
        <div class="admin-dashboard">
            <div id="dashboardSection">
                <div class="stats-grid">
                    <div class="stat-card">
                        <span>Tổng số người tham gia</span>
                        <span id="statTotalParticipants">0</span>
                    </div>
                    <div class="stat-card">
                        <span>Tổng số lượt đã quay</span>
                        <span id="statTotalSpins">0</span>
                    </div>
                    <div class="stat-card">
                        <span>Tổng tỉ lệ phần trăm</span>
                        <span id="statTotalPercent">100%</span>
                    </div>
                </div>

                <div class="admin-section-title">
                    <span>✏️ Tiêu đề hiển thị trang Vòng Quay</span>
                </div>
                <div class="title-box-wrapper">
                    <input type="text" id="adminTitleInput" placeholder="Nhập tiêu đề hiển thị ngoài trang chủ...">
                    <button class="save-btn" id="saveTitleBtn">Cập nhật tiêu đề</button>
                </div>

                <div class="admin-section-title">
                    <span>⚙️ Quản lý Tỷ lệ trúng thưởng (%)</span>
                    <span style="font-size: 12px; color: #94a3b8; font-weight: 500;">Tổng % phải đạt 100%</span>
                </div>
                
                <div class="admin-table-wrapper">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th style="width: 80px;">STT</th>
                                <th>Tên người tham gia</th>
                                <th style="width: 220px; text-align: center;">Tỷ lệ trúng thưởng (%)</th>
                            </tr>
                        </thead>
                        <tbody id="adminWeightTableBody"></tbody>
                    </table>
                </div>

                <div class="admin-actions-footer">
                    <button class="tool-btn" id="resetWeightsBtn">↺ Chia đều tỷ lệ (%)</button>
                    <button class="save-btn" id="saveAdminWeightsBtn">💾 Lưu cấu hình tỷ lệ</button>
                </div>
            </div>

            <div id="passwordSection" style="display: none;">
                <div class="admin-section-title" style="justify-content: center; margin-bottom: 25px;">
                    <span style="font-size: 18px;">🔐 Thay Đổi Mật Khẩu Quản Trị Hệ Thống</span>
                </div>
                
                <div class="password-container">
                    <input type="password" id="oldPassInput" placeholder="Mật khẩu hiện tại...">
                    <input type="password" id="newPassInput" placeholder="Mật khẩu mới (tối thiểu 3 ký tự)...">
                    <input type="password" id="confirmPassInput" placeholder="Xác nhận mật khẩu mới...">
                    <button class="save-btn" id="changePassBtn" style="margin-top: 10px; width: 100%;">Cập nhật mật khẩu mới</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        const authModal = document.getElementById('authModal');
        const adminPasswordInput = document.getElementById('adminPasswordInput');
        const loginBtn = document.getElementById('loginBtn');
        const errorMsg = document.getElementById('errorMsg');
        const adminMainContent = document.getElementById('adminMainContent');
        const logoutBtn = document.getElementById('logoutBtn');

        const tabDashboardBtn = document.getElementById('tabDashboardBtn');
        const tabPasswordBtn = document.getElementById('tabPasswordBtn');
        const dashboardSection = document.getElementById('dashboardSection');
        const passwordSection = document.getElementById('passwordSection');
        const pageTitleText = document.getElementById('pageTitleText');

        tabDashboardBtn.addEventListener('click', () => {
            tabDashboardBtn.classList.add('active');
            tabPasswordBtn.classList.remove('active');
            dashboardSection.style.display = 'block';
            passwordSection.style.display = 'none';
            pageTitleText.innerText = "Hệ Thống Quản Trị Vòng Quay";
        });

        tabPasswordBtn.addEventListener('click', () => {
            tabPasswordBtn.classList.add('active');
            tabDashboardBtn.classList.remove('active');
            dashboardSection.style.display = 'none';
            passwordSection.style.display = 'block';
            pageTitleText.innerText = "Bảo Mật Hệ Thống";
        });

        function getStoredPassword() {
            return localStorage.getItem('ultimate_admin_password_v11') || "123";
        }

        if (sessionStorage.getItem('admin_logged_in') === 'true') {
            authModal.style.display = 'none';
            adminMainContent.style.display = 'flex';
            initAdmin();
        }

        function handleLogin() {
            const currentPass = getStoredPassword();
            if (adminPasswordInput.value === currentPass) {
                sessionStorage.setItem('admin_logged_in', 'true');
                authModal.style.display = 'none';
                adminMainContent.style.display = 'flex';
                initAdmin();
            } else {
                errorMsg.style.display = 'block';
                adminPasswordInput.value = '';
            }
        }

        loginBtn.addEventListener('click', handleLogin);
        adminPasswordInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') handleLogin();
        });

        logoutBtn.addEventListener('click', () => {
            sessionStorage.removeItem('admin_logged_in');
            adminMainContent.style.display = 'none';
            authModal.style.display = 'flex';
            adminPasswordInput.value = '';
            errorMsg.style.display = 'none';
        });

        function escapeHTML(str) {
            const p = document.createElement('p');
            p.textContent = str;
            return p.innerHTML;
        }

        function initAdmin() {
            const statTotalParticipants = document.getElementById('statTotalParticipants');
            const statTotalSpins = document.getElementById('statTotalSpins');
            const statTotalPercent = document.getElementById('statTotalPercent');
            const adminWeightTableBody = document.getElementById('adminWeightTableBody');
            const saveAdminWeightsBtn = document.getElementById('saveAdminWeightsBtn');
            const resetWeightsBtn = document.getElementById('resetWeightsBtn');
            const adminTitleInput = document.getElementById('adminTitleInput');
            const saveTitleBtn = document.getElementById('saveTitleBtn');
            
            const oldPassInput = document.getElementById('oldPassInput');
            const newPassInput = document.getElementById('newPassInput');
            const confirmPassInput = document.getElementById('confirmPassInput');
            const changePassBtn = document.getElementById('changePassBtn');

            let entries = [];
            let participantWeights = {};
            let historyData = [];

            function loadData() {
                const savedTitle = localStorage.getItem('ultimate_wheel_title_v11');
                if (savedTitle !== null) {
                    adminTitleInput.value = savedTitle;
                } else {
                    adminTitleInput.value = "Vòng Quay Lòng Vòng";
                }

                const savedEntries = localStorage.getItem('ultimate_wheel_entries_v11');
                if (savedEntries !== null) {
                    entries = savedEntries.split('\n').filter(item => item.trim() !== '');
                } else {
                    entries = ["An", "Bình", "Châu", "Dũng", "V.Hoàng", "Khoa", "Linh", "Nam", "Phương", "Quân"];
                }

                const savedWeights = localStorage.getItem('ultimate_wheel_weights_v11');
                if (savedWeights !== null) {
                    try { participantWeights = JSON.parse(savedWeights); } catch(e){}
                }

                const savedHistory = localStorage.getItem('ultimate_wheel_history_v11');
                if (savedHistory !== null) {
                    try { historyData = JSON.parse(savedHistory); } catch(e){}
                }
            }

            function saveData() {
                localStorage.setItem('ultimate_wheel_weights_v11', JSON.stringify(participantWeights));
            }

            function renderAdminDashboard() {
                loadData();
                statTotalParticipants.innerText = entries.length;
                statTotalSpins.innerText = historyData.length;

                const defaultPercent = entries.length > 0 ? (100 / entries.length).toFixed(1) : 0;
                let totalPercent = 0;

                adminWeightTableBody.innerHTML = entries.map((name, idx) => {
                    const w = participantWeights[name] !== undefined ? parseFloat(participantWeights[name]) : parseFloat(defaultPercent);
                    totalPercent += isNaN(w) ? 0 : w;
                    return `
                        <tr>
                            <td><b>${idx + 1}</b></td>
                            <td><b>${escapeHTML(name)}</b></td>
                            <td style="text-align: center; position: relative;">
                                <input type="number" min="0" max="100" step="0.1" value="${w}" data-name="${escapeHTML(name)}">
                                <span style="position: absolute; right: 28px; top: 50%; transform: translateY(-50%); color: #94a3b8; font-size: 13px; font-weight: 700; pointer-events: none;">%</span>
                            </td>
                        </tr>
                    `;
                }).join('');

                statTotalPercent.innerText = totalPercent.toFixed(1) + '%';
                if (Math.abs(totalPercent - 100) > 0.5) {
                    statTotalPercent.style.color = '#f43f5e';
                } else {
                    statTotalPercent.style.color = '#38bdf8';
                }
            }

            saveTitleBtn.addEventListener('click', () => {
                const newTitle = adminTitleInput.value.trim() || "Vòng Quay Lòng Vòng";
                localStorage.setItem('ultimate_wheel_title_v11', newTitle);
                alert("Đã cập nhật tiêu đề vòng quay thành công!");
            });

            changePassBtn.addEventListener('click', () => {
                const currentPass = getStoredPassword();
                const oldVal = oldPassInput.value;
                const newVal = newPassInput.value;
                const confirmVal = confirmPassInput.value;

                if (oldVal !== currentPass) {
                    alert("Mật khẩu hiện tại không chính xác!");
                    return;
                }
                if (!newVal || newVal.length < 3) {
                    alert("Mật khẩu mới phải có ít nhất 3 ký tự!");
                    return;
                }
                if (newVal !== confirmVal) {
                    alert("Xác nhận mật khẩu mới không khớp!");
                    return;
                }

                localStorage.setItem('ultimate_admin_password_v11', newVal);
                alert("Đổi mật khẩu quản trị thành công!");
                oldPassInput.value = '';
                newPassInput.value = '';
                confirmPassInput.value = '';
            });

            saveAdminWeightsBtn.addEventListener('click', () => {
                const inputs = adminWeightTableBody.querySelectorAll('input[type="number"]');
                let sum = 0;
                let tempWeights = {};

                inputs.forEach(input => {
                    const name = input.getAttribute('data-name');
                    const val = parseFloat(input.value);
                    const cleanVal = (!isNaN(val) && val >= 0) ? val : 0;
                    tempWeights[name] = cleanVal;
                    sum += cleanVal;
                });

                if (Math.abs(sum - 100) > 0.5) {
                    alert(`Tổng tỷ lệ hiện tại là ${sum.toFixed(1)}%. Vui lòng điều chỉnh tổng các mục đạt đúng 100% để đảm bảo xác suất chính xác!`);
                    return;
                }

                participantWeights = tempWeights;
                saveData();
                renderAdminDashboard();
                alert("Đã lưu cấu hình tỷ lệ phần trăm thành công!");
            });

            resetWeightsBtn.addEventListener('click', () => {
                if (entries.length === 0) return;
                const equalPercent = parseFloat((100 / entries.length).toFixed(2));
                participantWeights = {};
                entries.forEach(name => {
                    participantWeights[name] = equalPercent;
                });
                saveData();
                renderAdminDashboard();
                alert("Đã chia đều tỷ lệ cho tất cả người tham gia!");
            });

            window.addEventListener('storage', (e) => {
                if (e.key === 'ultimate_wheel_entries_v11' || e.key === 'ultimate_wheel_history_v11') {
                    renderAdminDashboard();
                }
            });

            renderAdminDashboard();
        }
    </script>
</body>
</html>
