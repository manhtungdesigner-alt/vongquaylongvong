        function exportExcel() {
            if (history.length === 0) {
                alert("Chưa có lịch sử để xuất!");
                return;
            }
            let csv = "STT,Phần Quà / Người Trúng,Thời Gian\n";
            history.forEach((h, idx) => {
                csv += `${idx + 1},"${h.name}","${h.time}"\n`;
            });
            const blob = new Blob(["\uFEFF" + csv], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `VongQuay_LichSu_${new Date().toISOString().slice(0,10)}.csv`;
            a.click();
        }

        function saveToLocalStorage() {
            localStorage.setItem('vong_quay_items', JSON.stringify(items));
            localStorage.setItem('vong_quay_history', JSON.stringify(history));
        }

        function loadFromStorage() {
            const savedItems = localStorage.getItem('vong_quay_items');
            if (savedItems) {
                try { items = JSON.parse(savedItems); } catch(e){}
            }
            const savedHist = localStorage.getItem('vong_quay_history');
            if (savedHist) {
                try { history = JSON.parse(savedHist); renderHistory(); } catch(e){}
            }

            // Check URL Params
            const params = new URLSearchParams(window.location.search);
            const sharedItems = params.get('items');
            if (sharedItems) {
                try {
                    items = JSON.parse(decodeURIComponent(sharedItems));
                } catch(e) {}
            }

            syncInputFromItems();
        }

