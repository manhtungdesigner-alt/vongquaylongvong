<!DOCTYPE html>
<html lang="vi" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vòng Quay Lòng Vòng - Liquid Glass Edition</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                }
            }
        }
    </script>
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Canvas Confetti CDN -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            --glass-bg: rgba(255, 255, 255, 0.08);
            --glass-border: rgba(255, 255, 255, 0.18);
            --glass-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        }
        
        body {
            font-family: 'Inter', sans-serif;
            background-color: #090d16;
            color: #f3f4f6;
            overflow-x: hidden;
        }

        /* Liquid Glass Panels */
        .glass-panel {
            background: var(--glass-bg);
            backdrop-filter: blur(24px) saturate(190%);
            -webkit-backdrop-filter: blur(24px) saturate(190%);
            border: 1px solid var(--glass-border);
            box-shadow: var(--glass-shadow), inset 0 1px 0 0 rgba(255, 255, 255, 0.25);
            border-radius: 1.5rem;
        }

        .glass-input {
            background: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.12);
            color: #ffffff;
            transition: all 0.3s ease;
        }
        .glass-input:focus {
            background: rgba(15, 23, 42, 0.8);
            border-color: rgba(99, 102, 241, 0.6);
            box-shadow: 0 0 20px rgba(99, 102, 241, 0.3);
            outline: none;
        }

        /* Liquid Glass Buttons */
        .glass-btn {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.18), rgba(255, 255, 255, 0.05));
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.4);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .glass-btn:hover {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.28), rgba(255, 255, 255, 0.1));
            border-color: rgba(255, 255, 255, 0.6);
            box-shadow: 0 10px 30px rgba(99, 102, 241, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.7);
            transform: translateY(-2px);
        }
        .glass-btn:active {
            transform: translateY(1px);
        }

        /* Dynamic Glowing Liquid Orbs Background */
        .liquid-orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            opacity: 0.5;
            z-index: -1;
            animation: floatOrb 18s ease-in-out infinite alternate;
            pointer-events: none;
        }
        @keyframes floatOrb {
            0% { transform: translate(0px, 0px) scale(1); }
            50% { transform: translate(60px, 80px) scale(1.15); }
            100% { transform: translate(-50px, 40px) scale(0.9); }
        }

        /* Custom Scrollbar for Glass panels */
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.02);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.2);
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.4);
        }

        /* Wheel Pointer Animation */
        #wheel-pointer {
            transform-origin: top center;
            transition: transform 0.05s ease-out;
        }
    </style>
</head>
<body class="min-h-screen relative flex flex-col justify-between selection:bg-indigo-500 selection:text-white">

    <div class="fixed inset-0 overflow-hidden pointer-events-none z-[-1]">
        <div class="liquid-orb w-[450px] h-[450px] bg-indigo-600 top-[-10%] left-[-10%] animate-[floatOrb_15s_infinite]"></div>
        <div class="liquid-orb w-[500px] h-[500px] bg-purple-600 bottom-[-15%] right-[-10%] animate-[floatOrb_20s_infinite_reverse]"></div>
        <div class="liquid-orb w-[350px] h-[350px] bg-cyan-500 top-[40%] right-[30%] animate-[floatOrb_12s_infinite]"></div>
    </div>

    <header class="w-full max-w-7xl mx-auto px-4 sm:px-6 py-4 mt-2">
        <div class="glass-panel px-6 py-4 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-500 to-pink-500 flex items-center justify-center shadow-lg shadow-indigo-500/30">
                    <i class="fa-solid fa-dharmachakra text-white text-xl animate-spin-slow"></i>
                </div>
                <div>
                    <h1 id="app-title" class="text-xl sm:text-2xl font-extrabold tracking-tight bg-gradient-to-r from-white via-indigo-200 to-pink-300 bg-clip-text text-transparent">
                        Vòng Quay Lòng Vòng
                    </h1>
                    <p id="app-subtitle" class="text-xs text-indigo-200/70 font-medium">Liquid Glass Ultimate Edition</p>
                </div>
            </div>

            <div class="flex items-center space-x-3">
                <!-- Navigation Tabs / View Switcher -->
                <div class="flex bg-black/30 p-1 rounded-xl border border-white/10">
                    <button onclick="switchView('wheel')" id="nav-wheel-btn" class="px-4 py-2 rounded-lg text-xs font-semibold bg-white/20 text-white shadow-md transition-all">
                        <i class="fa-solid fa-compass mr-1.5"></i> <span data-i18n="navWheel">Vòng Quay</span>
                    </button>
                    <button onclick="switchView('eq')" id="nav-eq-btn" class="px-4 py-2 rounded-lg text-xs font-semibold text-white/70 hover:text-white transition-all">
                        <i class="fa-solid fa-brain mr-1.5"></i> <span data-i18n="navEQ">Test EQ</span>
                    </button>
                </div>

                <!-- Language Selector -->
                <div class="relative">
                    <select id="lang-select" onchange="changeLanguage(this.value)" class="glass-input px-3 py-2 rounded-xl text-xs font-medium cursor-pointer appearance-none pr-8">
                        <option value="vi" class="bg-slate-900 text-white">🇻🇳 Tiếng Việt</option>
                        <option value="en" class="bg-slate-900 text-white">🇬🇧 English</option>
                        <option value="th" class="bg-slate-900 text-white">🇹🇭 ไทย</option>
                        <option value="ko" class="bg-slate-900 text-white">🇰🇷 한국어</option>
                        <option value="zh" class="bg-slate-900 text-white">🇨🇳 中文</option>
                    </select>
                    <i class="fa-solid fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-xs text-white/50 pointer-events-none"></i>
                </div>

                <!-- Audio Toggle -->
                <button onclick="toggleAudio()" id="audio-toggle-btn" class="glass-btn w-10 h-10 rounded-xl flex items-center justify-center text-white/90 hover:text-white">
                    <i id="audio-icon" class="fa-solid fa-volume-high"></i>
                </button>
            </div>
        </div>
    </header>

    <main class="w-full max-w-7xl mx-auto px-4 sm:px-6 py-6 flex-grow">
        
        <!-- ==================== VIEW 1: WHEEL OF FORTUNE ==================== -->
        <div id="view-wheel" class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            
            <!-- Left Column: Wheel Canvas & Controls -->
            <div class="lg:col-span-7 flex flex-col items-center justify-center glass-panel p-6 sm:p-8 relative">
                
                <!-- Wheel Wrapper -->
                <div class="relative w-full max-w-[420px] aspect-square flex items-center justify-center my-4">
                    <!-- Top Triangle Pointer with Glow -->
                    <div id="wheel-pointer" class="absolute -top-4 z-20 w-8 h-10 flex items-center justify-center drop-shadow-[0_0_12px_rgba(255,255,255,0.8)]">
                        <div class="w-0 h-0 border-x-[12px] border-x-transparent border-t-[24px] border-t-pink-500 filter drop-shadow-md"></div>
                    </div>

                    <!-- Canvas -->
                    <div class="relative w-full h-full rounded-full p-2 bg-gradient-to-tr from-white/20 to-white/5 backdrop-blur-md shadow-[0_0_50px_rgba(99,102,241,0.25)] border border-white/20">
                        <canvas id="wheel-canvas" class="w-full h-full rounded-full cursor-pointer" width="600" height="600"></canvas>
                        
                        <!-- Center Luxury Core -->
                        <div class="absolute inset-0 m-auto w-20 h-20 rounded-full bg-slate-950/90 border-2 border-white/30 shadow-[0_0_30px_rgba(0,0,0,0.8),inset_0_0_15px_rgba(255,255,255,0.2)] flex items-center justify-center cursor-pointer hover:scale-105 transition-transform" onclick="startSpin()">
                            <span class="text-xs font-extrabold uppercase tracking-widest bg-gradient-to-r from-pink-400 to-indigo-400 bg-clip-text text-transparent" data-i18n="spinCenter">QUAY</span>
                        </div>
                    </div>
                </div>

                <!-- Big Spin Action Button -->
                <button onclick="startSpin()" id="spin-btn" class="w-full max-w-md py-4 px-8 mt-4 rounded-2xl bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 font-bold text-lg text-white shadow-[0_10px_30px_rgba(99,102,241,0.4)] hover:shadow-[0_15px_40px_rgba(236,72,153,0.6)] border border-white/30 transition-all transform hover:-translate-y-1 active:translate-y-0">
                    <i class="fa-solid fa-play mr-2"></i> <span data-i18n="spinButton">QUAY NGAY LẬP TỨC</span>
                </button>

                <!-- Spin Settings Sliders -->
                <div class="w-full max-w-md mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs font-medium">
                    <div class="glass-panel p-3 flex flex-col gap-2">
                        <div class="flex justify-between text-indigo-200">
                            <span data-i18n="speedLabel">Tốc độ / Thời gian:</span>
                            <span id="speed-val">4s</span>
                        </div>
                        <input type="range" id="spin-duration" min="2" max="10" value="4" step="1" class="accent-pink-500 cursor-pointer" oninput="document.getElementById('speed-val').innerText = this.value + 's'">
                    </div>
                    <div class="glass-panel p-3 flex items-center justify-between">
                        <span class="text-indigo-200" data-i18n="autoRemoveLabel">Tự xóa người trúng:</span>
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" id="auto-remove" class="sr-only peer">
                            <div class="w-11 h-6 bg-white/20 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-gradient-to-r peer-checked:from-indigo-500 peer-checked:to-pink-500"></div>
                        </label>
                    </div>
                </div>

            </div>

            <!-- Right Column: List Inputs & History -->
            <div class="lg:col-span-5 flex flex-col gap-6">
                
                <!-- Inputs Section -->
                <div class="glass-panel p-6 flex flex-col gap-4">
                    <div class="flex items-center justify-between">
                        <h2 class="font-bold text-sm tracking-wide text-white flex items-center gap-2">
                            <i class="fa-solid fa-list-ul text-indigo-400"></i> <span data-i18n="participantsTitle">DANH SÁCH THAM GIA</span>
                        </h2>
                        <span id="item-count" class="text-xs px-2.5 py-1 rounded-full bg-indigo-500/20 border border-indigo-500/30 text-indigo-300 font-semibold">0 mục</span>
                    </div>

                    <textarea id="items-input" rows="5" class="glass-input p-3 rounded-xl text-sm resize-none" placeholder="Nhập mỗi dòng một tên..." oninput="updateWheelFromInput()"></textarea>

                    <!-- Quick Tools -->
                    <div class="grid grid-cols-3 gap-2">
                        <button onclick="quickAddTemplate('friends')" class="glass-btn py-2 px-3 rounded-xl text-xs font-semibold text-white/90 hover:text-white flex items-center justify-center gap-1.5">
                            <i class="fa-solid fa-user-group text-indigo-400"></i> <span data-i18n="btnFriends">Bạn bè</span>
                        </button>
                        <button onclick="quickAddTemplate('numbers')" class="glass-btn py-2 px-3 rounded-xl text-xs font-semibold text-white/90 hover:text-white flex items-center justify-center gap-1.5">
                            <i class="fa-solid fa-hashtag text-cyan-400"></i> <span data-i18n="btnNumbers">Số 1-10</span>
                        </button>
                        <button onclick="quickAddTemplate('food')" class="glass-btn py-2 px-3 rounded-xl text-xs font-semibold text-white/90 hover:text-white flex items-center justify-center gap-1.5">
                            <i class="fa-solid fa-utensils text-pink-400"></i> <span data-i18n="btnFood">Món ăn</span>
                        </button>
                    </div>

                    <div class="flex gap-2 pt-1">
                        <button onclick="shuffleItems()" class="flex-1 glass-btn py-2 px-3 rounded-xl text-xs font-semibold text-white/90 flex items-center justify-center gap-1.5">
                            <i class="fa-solid fa-shuffle"></i> <span data-i18n="btnShuffle">Trộn tên</span>
                        </button>
                        <button onclick="removeDuplicates()" class="flex-1 glass-btn py-2 px-3 rounded-xl text-xs font-semibold text-white/90 flex items-center justify-center gap-1.5">
                            <i class="fa-solid fa-clone"></i> <span data-i18n="btnUnique">Xóa trùng</span>
                        </button>
                        <button onclick="shareLink()" class="glass-btn py-2 px-3 rounded-xl text-xs font-semibold text-white/90 flex items-center justify-center gap-1.5" title="Chia sẻ link">
                            <i class="fa-solid fa-share-nodes text-indigo-400"></i>
                        </button>
                    </div>
                </div>

                <!-- History Section -->
                <div class="glass-panel p-6 flex flex-col gap-4 flex-grow">
                    <div class="flex items-center justify-between">
                        <h2 class="font-bold text-sm tracking-wide text-white flex items-center gap-2">
                            <i class="fa-solid fa-clock-rotate-left text-pink-400"></i> <span data-i18n="historyTitle">LỊCH SỬ TRÚNG THƯỞNG</span>
                        </h2>
                        <div class="flex gap-2">
                            <button onclick="exportExcel()" class="glass-btn px-2.5 py-1 rounded-lg text-xs font-semibold text-emerald-300 hover:text-emerald-200" title="Xuất file">
                                <i class="fa-solid fa-file-excel mr-1"></i> <span data-i18n="btnExport">Excel</span>
                            </button>
                            <button onclick="clearHistory()" class="glass-btn px-2.5 py-1 rounded-lg text-xs font-semibold text-rose-300 hover:text-rose-200" title="Xóa lịch sử">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>
                        </div>
                    </div>

                    <div id="history-list" class="flex flex-col gap-2 max-h-[220px] overflow-y-auto pr-1">
                        <div class="text-center text-xs text-white/40 py-6" data-i18n="noHistory">Chưa có lịch sử quay nào</div>
                    </div>
                </div>

            </div>

        </div>

        <!-- ==================== VIEW 2: TEST EQ MODULE ==================== -->
        <div id="view-eq" class="hidden grid grid-cols-1 lg:grid-cols-12 gap-6">
            <div class="lg:col-span-12 glass-panel p-8 flex flex-col items-center text-center">
                <div class="w-16 h-16 rounded-2xl bg-gradient-to-tr from-cyan-500 to-indigo-600 flex items-center justify-center shadow-lg shadow-cyan-500/30 mb-4">
                    <i class="fa-solid fa-brain text-white text-2xl"></i>
                </div>
                <h2 class="text-2xl font-extrabold text-white mb-2" data-i18n="eqTitle">Đánh Giá Trí Tuệ Cảm Xúc (EQ Test)</h2>
                <p class="text-sm text-indigo-200/70 max-w-xl mb-8" data-i18n="eqDesc">Khám phá chỉ số EQ của bạn qua các tình huống thực tế được thiết kế chuẩn tâm lý học hiện đại với giao diện Liquid Glass.</p>

                <!-- EQ Quiz Container -->
                <div id="eq-quiz-box" class="w-full max-w-2xl glass-panel p-6 text-left flex flex-col gap-6">
                    <div class="flex justify-between items-center text-xs text-indigo-300 font-semibold border-b border-white/10 pb-3">
                        <span id="eq-question-progress">Câu hỏi 1 / 5</span>
                        <span id="eq-category">Nhận thức bản thân</span>
                    </div>
                    <h3 id="eq-question-text" class="text-lg font-bold text-white">Khi bạn gặp một áp lực lớn trong công việc hoặc học tập, phản ứng đầu tiên của bạn là gì?</h3>
                    <div id="eq-options-container" class="flex flex-col gap-3">
                        <!-- Options injected dynamically -->
                    </div>
                </div>

                <!-- EQ Result Box -->
                <div id="eq-result-box" class="hidden w-full max-w-2xl glass-panel p-8 text-center flex flex-col items-center gap-4">
                    <div class="w-20 h-20 rounded-full bg-gradient-to-tr from-pink-500 to-amber-500 flex items-center justify-center text-3xl font-extrabold text-white shadow-xl shadow-pink-500/30" id="eq-score-badge">
                        125
                    </div>
                    <h3 class="text-2xl font-bold text-white" id="eq-result-title">Chỉ số EQ Xuất Sắc!</h3>
                    <p class="text-sm text-indigo-200/80 max-w-md" id="eq-result-desc">Bạn có khả năng thấu cảm và kiểm soát cảm xúc vô cùng tuyệt vời, luôn là chỗ dựa tin cậy cho mọi người xung quanh.</p>
                    <button onclick="restartEQ()" class="glass-btn px-6 py-3 rounded-xl text-xs font-bold text-white mt-4">
                        <i class="fa-solid fa-rotate-right mr-2"></i> <span data-i18n="eqRetest">Làm lại bài Test</span>
                    </button>
                </div>
            </div>
        </div>

    </main>

    <footer class="w-full max-w-7xl mx-auto px-4 sm:px-6 py-4 text-center text-xs text-white/40">
        <p>Vòng Quay Lòng Vòng &copy; 2026 • Liquid Glass Futuristic Architecture</p>
    </footer>

    <div id="winner-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-md opacity-0 pointer-events-none transition-all duration-300">
        <div class="glass-panel p-8 max-w-sm w-full mx-4 text-center transform scale-95 transition-transform duration-300 flex flex-col items-center gap-4 border-2 border-pink-500/50 shadow-[0_0_60px_rgba(236,72,153,0.4)]">
            <div class="w-20 h-20 rounded-full bg-gradient-to-tr from-pink-500 via-purple-500 to-indigo-500 flex items-center justify-center text-3xl text-white shadow-lg shadow-pink-500/50 animate-bounce">
                <i class="fa-solid fa-trophy"></i>
            </div>
            <span class="text-xs uppercase tracking-widest text-pink-400 font-extrabold" data-i18n="winnerHeader">KẾT QUẢ VINH DƯƠNG</span>
            <h2 id="winner-name" class="text-2xl sm:text-3xl font-extrabold text-white bg-gradient-to-r from-white via-indigo-200 to-pink-300 bg-clip-text text-transparent"></h2>
            <p class="text-xs text-indigo-200/70" data-i18n="winnerText">Đã xuất sắc trúng thưởng phần quà giá trị từ vòng quay!</p>
            <button onclick="closeWinnerModal()" class="w-full py-3 rounded-xl bg-gradient-to-r from-indigo-600 to-pink-600 font-bold text-xs text-white shadow-lg hover:shadow-indigo-500/50 transition-all mt-2">
                <span data-i18n="btnContinue">TIẾP TỤC QUAY</span>
            </button>
        </div>
    </div>

